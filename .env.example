# Copia este archivo a .env.local y llena los valores.
# NUNCA subas .env.local al repo.

# API key de pey (portal.pey.mx -> Developer -> API keys)
PEY_API_KEY=

# Secreto del webhook, empieza con whsec_ (portal -> Webhooks -> tu endpoint)
PEY_WEBHOOK_SECRET=

# https://api.pey.mx (producción) | https://api.dev.pey.mx (pruebas, si tu key es de dev)
PEY_BASE_URL=https://api.pey.mx

# Nombre que se muestra en el concepto del cobro.
# OJO: no uses "pey" ni "CoDi" en el nombre del producto (reglas del hackatón).
NEGOCIO_NOMBRE=El Mostrador

# Carpeta de la base local (SQLite). En producción esto se reemplaza por Postgres.
DATA_DIR=.data

# Segundos que vive un QR de cobro. 900 = 15 min: el cliente tiene que abrir su
# banco e iniciar sesión; con 600 se vencía en la fila. 0 = no expira.
QR_EXPIRACION=900

# Reconciliación de fondo cada 30 s: cierra las ventas que se quedaron en `cobrando`
# aunque el webhook no llegue y aunque nadie tenga la pantalla abierta.
# Pon `off` solo para depurar.
RECONCILIACION=on

